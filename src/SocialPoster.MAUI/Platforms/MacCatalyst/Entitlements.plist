<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <!-- No App Sandbox: the app shares its data folder (~/Library/Application Support/SocialPoster) with the
             SocialPoster.Web sample and the account finder starts the Copilot CLI as a child process. Enable the
             sandbox (and give it its own data folder) only if you distribute through the Mac App Store. -->
        <key>com.apple.security.app-sandbox</key>
        <false/>
        <key>com.apple.security.network.client</key>
        <true/>
    </dict>
</plist>
