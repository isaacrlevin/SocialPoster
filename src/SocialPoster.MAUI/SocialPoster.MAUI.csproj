<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Desktop only: Windows when building on Windows, Mac Catalyst when building on macOS. -->
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net11.0-windows10.0.19041.0</TargetFrameworks>
        <!-- MacCatalystSdkVersion (for example 26.0) builds against an older SDK pack when Xcode is behind the newest one. -->
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net11.0-maccatalyst$(MacCatalystSdkVersion)</TargetFrameworks>
        <IsMauiPlatform Condition="'$(TargetFrameworks)' != ''">true</IsMauiPlatform>

        <OutputType>Exe</OutputType>
        <RootNamespace>SocialPoster.MAUI</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>SocialPoster</ApplicationTitle>
        <ApplicationId>com.isaacrlevin.socialposter</ApplicationId>
        <ApplicationDisplayVersion>0.7.2</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Run unpackaged on Windows, like a normal desktop exe. See https://aka.ms/MauiTemplateUnpackaged
             Pass -p:WindowsPackageType=MSIX to build the Microsoft Store package instead. -->
        <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!-- Linux has no MAUI desktop target: build an empty placeholder so `dotnet build` of the solution still works. -->
    <PropertyGroup Condition="'$(IsMauiPlatform)' != 'true'">
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Library</OutputType>
        <UseMaui>false</UseMaui>
        <EnableDefaultItems>false</EnableDefaultItems>
        <EnableDefaultRazorComponentItems>false</EnableDefaultRazorComponentItems>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <!-- Core, Components and this app each copy the same Copilot CLI files into their output, so `dotnet publish`
             sees duplicates. They are identical, so let one copy win. -->
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    </PropertyGroup>

    <!-- Microsoft Store (MSIX) package. Copy the three Store* values from Partner Center: Product management >
         Product identity (Package/Identity/Name, Package/Identity/Publisher, Package/Properties/PublisherDisplayName). -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(WindowsPackageType)' == 'MSIX'">
        <StoreIdentityName Condition="'$(StoreIdentityName)' == ''">37828IsaacLevin.SocialPoster</StoreIdentityName>
        <StorePublisher Condition="'$(StorePublisher)' == ''">CN=82A4CBF8-0920-4FD3-B44C-A9D0D7BB5865</StorePublisher>
        <StorePublisherDisplayName Condition="'$(StorePublisherDisplayName)' == ''">Isaac Levin</StorePublisherDisplayName>
        <!-- The Store requires the fourth (revision) part of the package version to be 0. -->
        <StorePackageVersion Condition="'$(StorePackageVersion)' == ''">$(ApplicationDisplayVersion).0</StorePackageVersion>

        <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
        <!-- The Store signs packages on submission. To sideload a test build, pass -p:AppxPackageSigningEnabled=true
             and -p:PackageCertificateThumbprint=<thumbprint of a cert whose subject matches StorePublisher>. -->
        <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
        <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
        <!-- Keep the manifest's TargetDeviceFamily (MinVersion 19041 for the virtualization exclusion, a current
             MaxVersionTested) instead of letting the packaging tools regenerate it from the properties below. -->
        <AppxAddDefaultTargetDeviceFamilyItem>false</AppxAddDefaultTargetDeviceFamilyItem>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <!-- Both architectures so the app runs on Intel and Apple silicon Macs. -->
        <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers>
        <!-- EF Core, System.Text.Json and the agent use reflection, so keep every assembly intact in Release too. -->
        <MtouchLink>None</MtouchLink>
        <!-- Release publishes of Mac Catalyst apps are fully AOT-compiled, which disables runtime code generation.
             EF Core then refuses to build its model at startup ("Model building is not supported when publishing
             with NativeAOT"). The interpreter keeps dynamic code working, as EF Core, expression trees and the
             agent's serializers need. -->
        <UseInterpreter>true</UseInterpreter>
        <!-- The Copilot CLI is a Node bundle the Mac Catalyst app bundler can't package, so don't bundle it;
             MauiProgram points the SDK at an installed `copilot` instead. -->
        <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsMauiPlatform)' == 'true'">
        <!-- No Color on the icon so the rounded background keeps its transparent corners. -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4F46E5" BaseSize="128,128" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsMauiPlatform)' == 'true'">
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.130" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.130" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
        <ProjectReference Include="..\SocialPoster.Components\SocialPoster.Components.csproj" />
    </ItemGroup>

    <!-- Components and Core also copy the CLI into their output, which flows into this app. Skip it there too. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <ProjectReference Update="..\SocialPoster.Components\SocialPoster.Components.csproj" AdditionalProperties="CopilotSkipCliDownload=true" />
    </ItemGroup>

    <!-- MAUI generates the final Package.appxmanifest from Platforms\Windows\Package.appxmanifest. Stamp the Store
         identity and version onto that generated copy so they're set in one place (the properties above). -->
    <Target Name="_SocialPosterStampStoreIdentity" AfterTargets="MauiGeneratePackageAppxManifest"
            Condition="'$(WindowsPackageType)' == 'MSIX' and '@(AppxManifest)' != ''">
        <Error Condition="$(StoreIdentityName.StartsWith('TODO')) or $(StorePublisher.Contains('TODO'))"
               Text="Set StoreIdentityName and StorePublisher in SocialPoster.MAUI.csproj (or pass them with -p:) to the values from Partner Center before building the Store package." />
        <PropertyGroup>
            <_SocialPosterAppxNs>&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;</_SocialPosterAppxNs>
        </PropertyGroup>
        <XmlPoke XmlInputPath="@(AppxManifest)" Namespaces="$(_SocialPosterAppxNs)" Query="/m:Package/m:Identity/@Name" Value="$(StoreIdentityName)" />
        <XmlPoke XmlInputPath="@(AppxManifest)" Namespaces="$(_SocialPosterAppxNs)" Query="/m:Package/m:Identity/@Publisher" Value="$(StorePublisher)" />
        <XmlPoke XmlInputPath="@(AppxManifest)" Namespaces="$(_SocialPosterAppxNs)" Query="/m:Package/m:Identity/@Version" Value="$(StorePackageVersion)" />
        <XmlPoke XmlInputPath="@(AppxManifest)" Namespaces="$(_SocialPosterAppxNs)" Query="/m:Package/m:Properties/m:PublisherDisplayName" Value="$(StorePublisherDisplayName)" />
    </Target>

    <!-- Core and Components copy the Copilot CLI for the build machine (x64) into runtimes\win-x64; a non-x64 app has its
         own copy, so leave the x64 one out of the MSIX (CI deletes it from the zip for the same reason). -->
    <Target Name="_SocialPosterTrimForeignCopilotCli" AfterTargets="_ComputeAppxPackagePayload"
            Condition="'$(WindowsPackageType)' == 'MSIX' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'">
        <ItemGroup>
            <AppxPackagePayload Remove="@(AppxPackagePayload)"
                                Condition="$([System.String]::Copy('%(AppxPackagePayload.TargetPath)').StartsWith('runtimes\win-x64\', StringComparison.OrdinalIgnoreCase))" />
        </ItemGroup>
    </Target>

</Project>
