@if (Ok)
{
    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle" Class="ms-1">Connected</MudChip>
}
else
{
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ms-1">Not connected</MudChip>
}

@code {
    [Parameter] public bool Ok { get; set; }
}
