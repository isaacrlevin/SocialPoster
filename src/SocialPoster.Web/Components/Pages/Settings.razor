@page "/settings"
@inject SecretStore Secrets
@inject BlueskyClient BlueskyApi
@inject XClient XApi
@inject LinkedInClient LinkedInApi
@inject AccountFinder Finder

<PageTitle>Accounts · SocialPoster</PageTitle>

<PageHeader Title="Accounts" Subtitle="Connect the platforms you want to publish to." />

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Lock" Class="mb-6">
    Credentials are stored only on this computer, in a local SQLite database encrypted with ASP.NET Core Data Protection
    (keys are protected with DPAPI on Windows; on Linux/macOS they rely on owner-only file permissions).
</MudAlert>

<MudGrid Spacing="4">
    <MudItem xs="12" lg="4">
        <MudPaper Class="sp-card h-100 d-flex flex-column" Elevation="0">
            <div class="sp-card-header platform-bluesky" style="border-top:0 !important">
                <span class="platform-icon" style="background:#1185fe">🦋</span>
                <MudText Typo="Typo.h6">Bluesky</MudText>
                <StatusBadge Ok="@bskyOk" />
            </div>
            <div class="sp-card-body flex-grow-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Search and follows sync work without logging in. To publish, create an
                    <MudLink Href="https://bsky.app/settings/app-passwords" Target="_blank">app password</MudLink>.
                </MudText>
                <MudStack Spacing="2">
                    <MudTextField T="string" @bind-Value="bskyHandle" Label="Your handle" Placeholder="you.bsky.social" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" @bind-Value="bskyPassword" Label="App password" InputType="InputType.Password" Placeholder="@(bskyHasPassword ? "•••• saved" : "xxxx-xxxx-xxxx-xxxx")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudExpansionPanels Elevation="0" Class="sp-advanced">
                        <MudExpansionPanel Text="Advanced" Dense="true">
                            <MudTextField T="string" @bind-Value="bskyService" Label="PDS / service URL" Placeholder="https://bsky.social" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudStack>
                <Feedback Text="@bskyMsg" IsError="@bskyErr" />
            </div>
            <div class="sp-card-footer">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveBlueskyAsync" Disabled="@busy">Save</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="TestBlueskyAsync" Disabled="@busy">Test login</MudButton>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="4">
        <MudPaper Class="sp-card h-100 d-flex flex-column" Elevation="0">
            <div class="sp-card-header">
                <span class="platform-icon" style="background:#111">𝕏</span>
                <MudText Typo="Typo.h6">X</MudText>
                <StatusBadge Ok="@(xOk || xUseIntent)" />
            </div>
            <div class="sp-card-body flex-grow-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Create an app in the <MudLink Href="https://developer.x.com/en/portal/dashboard" Target="_blank">X developer portal</MudLink> with <em>Read and write</em> permissions,
                    then generate an Access Token and Secret for your account. Posts and lookups count toward your X API plan.
                </MudText>
                <MudStack Spacing="2">
                    <MudTextField T="string" @bind-Value="xConsumerKey" Label="API Key (consumer key)" InputType="InputType.Password" Placeholder="@Placeholder(xHas[0])" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" @bind-Value="xConsumerSecret" Label="API Key Secret" InputType="InputType.Password" Placeholder="@Placeholder(xHas[1])" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" @bind-Value="xAccessToken" Label="Access Token" InputType="InputType.Password" Placeholder="@Placeholder(xHas[2])" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" @bind-Value="xAccessSecret" Label="Access Token Secret" InputType="InputType.Password" Placeholder="@Placeholder(xHas[3])" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudStack>
                <MudSwitch T="bool" @bind-Value="xUseIntent" Color="Color.Primary" Class="mt-2" Label="Post via browser instead (free, no API access needed)" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Opens x.com with your post pre-filled; you click Post yourself there. Skips the X API entirely, so credentials above aren't required for posting (they're still used to Verify accounts).</MudText>
                <Feedback Text="@xMsg" IsError="@xErr" />
            </div>
            <div class="sp-card-footer">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveXAsync" Disabled="@busy">Save</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="TestXAsync" Disabled="@busy">Test</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Class="ms-auto" OnClick="ClearXAsync" Disabled="@busy">Remove</MudButton>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="4">
        <MudPaper Class="sp-card h-100 d-flex flex-column" Elevation="0">
            <div class="sp-card-header">
                <span class="platform-icon" style="background:#0a66c2">in</span>
                <MudText Typo="Typo.h6">LinkedIn</MudText>
                <StatusBadge Ok="@liOk" />
            </div>
            <div class="sp-card-body flex-grow-1">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Paste an existing access token with <code>openid</code>, <code>profile</code>, and <code>w_member_social</code> permissions.
                    SocialPoster uses this token as-is and does not generate or revoke LinkedIn tokens.
                </MudText>
                <MudStack Spacing="2">
                    <MudTextField T="string" @bind-Value="liAccessToken" Label="Access token" InputType="InputType.Password" Placeholder="@Placeholder(liHasToken)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" @bind-Value="liVersion" Label="API version (YYYYMM)" Placeholder="@LinkedInClient.DefaultApiVersion" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudStack>
                @if (liName is not null)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">Connected as <strong>@liName</strong></MudText>
                }
                <Feedback Text="@liMsg" IsError="@liErr" />
            </div>
            <div class="sp-card-footer">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveLinkedInAsync" Disabled="@busy">Save</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="TestLinkedInAsync" Disabled="@busy">Verify token</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Class="ms-auto" OnClick="ForgetLinkedInAsync" Disabled="@busy">Forget token</MudButton>
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="sp-card" Elevation="0">
            <div class="sp-card-header">
                <span class="platform-icon" style="background:linear-gradient(135deg,var(--mud-palette-primary),var(--mud-palette-tertiary))"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" /></span>
                <MudText Typo="Typo.h6">Copilot account finder</MudText>
                <StatusBadge Ok="@(cpEnabled && cpOk == true)" />
            </div>
            <div class="sp-card-body">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Uses your GitHub Copilot subscription (through the Copilot SDK) to search the web for people's X and LinkedIn accounts, so you can pick the right one.
                    It signs in the same way as the GitHub Copilot app and CLI. Each search uses Copilot premium requests at the chosen model's rate.
                </MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="3">
                        <MudSwitch T="bool" @bind-Value="cpEnabled" Color="Color.Primary" Label="Enabled" />
                        <MudTooltip Text="When you mention someone who's missing an X or LinkedIn account, search for them in the background (once per contact).">
                            <MudSwitch T="bool" @bind-Value="cpAuto" Color="Color.Primary" Disabled="@(!cpEnabled)" Label="Search automatically" />
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" @bind-Value="cpModel" Label="Model" Placeholder="@AccountFinder.DefaultModel" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="@($"Small, fast models work well. {AccountFinder.DefaultModel} takes about 30 seconds per search.")" />
                        @if (cpModels.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @foreach (var m in cpModels)
                                {
                                    var model = m;
                                    <MudChip T="string" Size="Size.Small" Variant="@(cpModel == model ? Variant.Filled : Variant.Outlined)" Color="@(cpModel == model ? Color.Primary : Color.Default)" OnClick="() => cpModel = model">@model</MudChip>
                                }
                            </div>
                        }
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudTextField T="string" @bind-Value="cpToken" Label="GitHub token (optional)" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Placeholder="@(cpHasToken ? "•••• saved (leave blank to keep)" : "Only if you're not signed in to Copilot on this PC")" />
                        @if (cpHasToken)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearCopilotTokenAsync">Remove token</MudButton>
                        }
                    </MudItem>
                </MudGrid>
                <Feedback Text="@cpMsg" IsError="@cpErr" />
            </div>
            <div class="sp-card-footer">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveCopilotAsync" Disabled="@busy">Save</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="TestCopilotAsync" Disabled="@busy">
                    @if (cpTesting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" /> }
                    Test connection
                </MudButton>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private bool busy;

    private string? bskyHandle, bskyPassword, bskyService, bskyMsg;
    private bool bskyHasPassword, bskyErr, bskyOk;

    private string? xConsumerKey, xConsumerSecret, xAccessToken, xAccessSecret, xMsg;
    private bool[] xHas = new bool[4];
    private bool xErr, xOk, xUseIntent;

    private string? liAccessToken, liVersion, liName, liMsg;
    private bool liHasToken, liErr, liOk;

    private bool cpEnabled = true, cpAuto = true, cpHasToken, cpErr, cpTesting;
    private bool? cpOk;
    private string? cpModel, cpToken, cpMsg;
    private IReadOnlyList<string> cpModels = [];

    private static string Placeholder(bool saved) => saved ? "•••• saved (leave blank to keep)" : "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        bskyHandle = await Secrets.GetAsync(SettingKeys.BlueskyHandle);
        bskyService = await Secrets.GetAsync(SettingKeys.BlueskyService);
        bskyHasPassword = await Secrets.GetAsync(SettingKeys.BlueskyAppPassword) is not null;
        bskyOk = await BlueskyApi.IsConfiguredAsync();

        string[] xKeys = [SettingKeys.XConsumerKey, SettingKeys.XConsumerSecret, SettingKeys.XAccessToken, SettingKeys.XAccessTokenSecret];
        for (var i = 0; i < xKeys.Length; i++) xHas[i] = await Secrets.GetAsync(xKeys[i]) is not null;
        xOk = await XApi.IsConfiguredAsync();
        xUseIntent = await Secrets.GetAsync(SettingKeys.XPostMethod) == "intent";

        liHasToken = await Secrets.GetAsync(SettingKeys.LinkedInAccessToken) is not null;
        liVersion = await Secrets.GetAsync(SettingKeys.LinkedInApiVersion);
        liName = await Secrets.GetAsync(SettingKeys.LinkedInName);
        liOk = await LinkedInApi.IsConfiguredAsync();

        var cp = await Finder.GetSettingsAsync();
        cpEnabled = cp.Enabled;
        cpAuto = cp.AutoSearch;
        cpModel = await Secrets.GetAsync(SettingKeys.CopilotModel);
        cpHasToken = await Secrets.GetAsync(SettingKeys.CopilotGitHubToken) is not null;
    }

    private void ReportCp(string m, bool e) => (cpMsg, cpErr) = (m, e);

    private Task SaveCopilotAsync() => Run(async () =>
    {
        await Secrets.SetAsync(SettingKeys.CopilotEnabled, cpEnabled ? null : "false");
        await Secrets.SetAsync(SettingKeys.CopilotAutoSearch, cpAuto ? null : "false");
        await Secrets.SetAsync(SettingKeys.CopilotModel, string.IsNullOrWhiteSpace(cpModel) ? null : cpModel.Trim());
        await SetIfProvided(SettingKeys.CopilotGitHubToken, cpToken);
        cpToken = null;
        ReportCp("Saved.", false);
    }, ReportCp);

    private Task ClearCopilotTokenAsync() => Run(async () =>
    {
        await Secrets.SetAsync(SettingKeys.CopilotGitHubToken, null);
        ReportCp("Token removed. Copilot will use your signed-in account.", false);
    }, ReportCp);

    private async Task TestCopilotAsync()
    {
        cpTesting = true;
        await Run(async () =>
        {
            cpModels = await Finder.ListModelsAsync();
            cpOk = true;
            var model = string.IsNullOrWhiteSpace(cpModel) ? AccountFinder.DefaultModel : cpModel.Trim();
            ReportCp(cpModels.Contains(model)
                ? $"Connected to GitHub Copilot. {cpModels.Count} models available, including {model}."
                : $"Connected, but the model '{model}' isn't available to you. Pick one from the list.", !cpModels.Contains(model));
        }, (m, e) => { cpOk = false; ReportCp(m, e); });
        cpTesting = false;
    }

    private async Task SetIfProvided(string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value)) await Secrets.SetAsync(key, value.Trim());
    }

    private async Task Run(Func<Task> action, Action<string, bool> report)
    {
        busy = true;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            report(ex.Message, true);
        }
        finally
        {
            busy = false;
            await LoadAsync();
        }
    }

    private void ReportBsky(string m, bool e) => (bskyMsg, bskyErr) = (m, e);
    private void ReportX(string m, bool e) => (xMsg, xErr) = (m, e);
    private void ReportLi(string m, bool e) => (liMsg, liErr) = (m, e);

    private Task SaveBlueskyAsync() => Run(async () =>
    {
        await Secrets.SetAsync(SettingKeys.BlueskyHandle, bskyHandle?.Trim().TrimStart('@'));
        await Secrets.SetAsync(SettingKeys.BlueskyService, string.IsNullOrWhiteSpace(bskyService) ? null : bskyService.Trim());
        await SetIfProvided(SettingKeys.BlueskyAppPassword, bskyPassword);
        bskyPassword = null;
        ReportBsky("Saved.", false);
    }, ReportBsky);

    private Task TestBlueskyAsync() => Run(async () =>
    {
        var (did, handle) = await BlueskyApi.VerifyLoginAsync();
        ReportBsky($"Logged in as @{handle} ({did}).", false);
    }, ReportBsky);

    private Task SaveXAsync() => Run(async () =>
    {
        await SetIfProvided(SettingKeys.XConsumerKey, xConsumerKey);
        await SetIfProvided(SettingKeys.XConsumerSecret, xConsumerSecret);
        await SetIfProvided(SettingKeys.XAccessToken, xAccessToken);
        await SetIfProvided(SettingKeys.XAccessTokenSecret, xAccessSecret);
        await Secrets.SetAsync(SettingKeys.XPostMethod, xUseIntent ? "intent" : null);
        xConsumerKey = xConsumerSecret = xAccessToken = xAccessSecret = null;
        ReportX("Saved.", false);
    }, ReportX);

    private Task TestXAsync() => Run(async () =>
    {
        var me = await XApi.GetMeAsync();
        ReportX($"Authenticated as @{me.Username}.", false);
    }, ReportX);

    private Task ClearXAsync() => Run(async () =>
    {
        foreach (var k in new[] { SettingKeys.XConsumerKey, SettingKeys.XConsumerSecret, SettingKeys.XAccessToken, SettingKeys.XAccessTokenSecret })
            await Secrets.SetAsync(k, null);
        ReportX("Removed X credentials.", false);
    }, ReportX);

    private Task SaveLinkedInAsync() => Run(async () =>
    {
        if (!string.IsNullOrWhiteSpace(liAccessToken))
        {
            await LinkedInApi.SetAccessTokenAsync(liAccessToken);
            liAccessToken = null;
            liName = await Secrets.GetAsync(SettingKeys.LinkedInName);
            liHasToken = true;
        }
        await Secrets.SetAsync(SettingKeys.LinkedInApiVersion, string.IsNullOrWhiteSpace(liVersion) ? null : liVersion.Trim());
        ReportLi(liHasToken ? "Saved and verified. The supplied token was not changed." : "Saved.", false);
    }, ReportLi);

    private Task TestLinkedInAsync() => Run(async () =>
    {
        var name = await LinkedInApi.VerifyAccessTokenAsync();
        liName = name;
        ReportLi($"Token verified for {name}.", false);
    }, ReportLi);

    private Task ForgetLinkedInAsync() => Run(async () =>
    {
        await LinkedInApi.ForgetAccessTokenAsync();
        liAccessToken = null;
        liName = null;
        liHasToken = false;
        ReportLi("Token forgotten in this app only. This does not revoke it; LinkedIn's normal expiration still applies.", false);
    }, ReportLi);
}
