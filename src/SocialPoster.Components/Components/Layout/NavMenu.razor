@inject SocialPosterNavigation SocialPosterNavigation

<MudDrawerHeader Class="sp-brand">
    <svg class="sp-logo" viewBox="0 0 1024 1024" aria-hidden="true" focusable="false">
        <rect width="1024" height="1024" rx="228" fill="#4F46E5" />
        <g fill="none" stroke="#FFFFFF" stroke-width="34" stroke-linecap="round">
            <path d="M391 512C536 512 570 273.5 700 273.5" />
            <path d="M391 512H700" />
            <path d="M391 512C536 512 570 750.5 700 750.5" />
        </g>
        <circle cx="281" cy="512" r="111" fill="#FFFFFF" />
        <path d="M239 465.5v93a10 10 0 0 0 15.1 8.6l79.5-46.5a10 10 0 0 0 0-17.2l-79.5-46.5A10 10 0 0 0 239 465.5z" fill="#4F46E5" />
        <circle cx="776.5" cy="273.5" r="68" fill="#FBBF24" />
        <circle cx="776.5" cy="512" r="68" fill="#2DD4BF" />
        <circle cx="776.5" cy="750.5" r="68" fill="#F472B6" />
    </svg>
    <MudText Typo="Typo.h6" Class="sp-brand-name">SocialPoster</MudText>
</MudDrawerHeader>

<MudNavMenu Class="px-2" Color="Color.Primary" Rounded="true" Margin="Margin.Dense">
    <MudNavLink Href="@SocialPosterNavigation.Link()" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.EditNote">Compose</MudNavLink>
    <MudNavLink Href="@SocialPosterNavigation.Link("contacts")" Icon="@Icons.Material.Filled.People">Contacts</MudNavLink>
    <MudNavLink Href="@SocialPosterNavigation.Link("history")" Icon="@Icons.Material.Filled.History">History</MudNavLink>
    <MudNavLink Href="@SocialPosterNavigation.Link("settings")" Icon="@Icons.Material.Filled.ManageAccounts">Accounts</MudNavLink>
</MudNavMenu>
