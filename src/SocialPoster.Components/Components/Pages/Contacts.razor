    private async Task DeleteAsync(Contact c)
    {
        if (syncing || busy || merging) return;
        busy = true;
        try
        {
            if (await Dialogs.ShowMessageBoxAsync("Delete contact", $"Delete {c.DisplayName}? Drafts using {{@{c.Key}}} will show it as unknown.", yesText: "Delete", cancelText: "Cancel") != true)
            {
                return;
            }

            if (syncing || disposed) return;
            await ContactSvc.DeleteAsync(c.Id);
            mergeSelection.Remove(c.Id);
            conflicts = conflicts?.Where(pair => pair.Left.Id != c.Id && pair.Right.Id != c.Id).ToList();
            await PersistConflictsAsync();
            if (editing?.Id == c.Id) editing = null;
            await LoadAsync();
        }
        finally { busy = false; }
    }

