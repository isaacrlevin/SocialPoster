    private bool disposed;
    private CancellationTokenSource? syncCancellation;
    private IDialogReference? syncDialog;
    private bool CanStartSync => !disposed && !syncing && !busy && !scanningConflicts &&
        !confirmingConflictScan && !merging && editing is null;

    private async Task<IDialogReference> OpenSyncDialogAsync<T>(string title, DialogParameters parameters, CancellationToken ct)
        where T : IComponent
    {
        ct.ThrowIfCancellationRequested();
        return await AwaitSyncDialogOpenAsync(Dialogs.ShowAsync<T>(title, parameters, SyncDialogOptions), ct);
    }

    private static async Task<IDialogReference> AwaitSyncDialogOpenAsync(Task<IDialogReference> opening, CancellationToken ct)
    {
        try { return await opening.WaitAsync(ct); }
        catch (OperationCanceledException)
        {
            // Navigation can dispose the provider before ShowAsync finishes rendering. Release the
            // sync immediately, and close a late dialog rather than leaving it over the next page.
            _ = opening.ContinueWith(completed =>
            {
                if (completed.IsCompletedSuccessfully) completed.Result.Close();
                else _ = completed.Exception; // Observe late rendering failures.
            }, CancellationToken.None, TaskContinuationOptions.ExecuteSynchronously, TaskScheduler.Default);
            throw;
        }
    }

    private async Task<DialogResult?> WaitForSyncDialogAsync(IDialogReference dialog, CancellationToken ct)
    {
        syncDialog = dialog;
        try { return await dialog.Result.WaitAsync(ct); }
        finally
        {
            dialog.Close();
            if (ReferenceEquals(syncDialog, dialog)) syncDialog = null;
        }
    }

    private async Task<ContactImportDecision> ReviewImportAsync(ContactImportReview review, CancellationToken ct)
    {
        while (true)
        {
            ct.ThrowIfCancellationRequested();
            var selection = await OpenSyncDialogAsync<ImportDuplicatesDialog>("Handle Duplicates",
                new DialogParameters { [nameof(ImportDuplicatesDialog.Review)] = review }, ct);
            var result = await WaitForSyncDialogAsync(selection, ct);
            if (result is null || result.Canceled) return new(ImportReviewAction.Cancel);
            var decision = (ContactImportDecision)result.Data!;
            if (decision.Action != ImportReviewAction.Merge) return decision;
            var preview = review.Candidates.Single(p => p.Left.Id == decision.ContactId);
            var merge = await OpenSyncDialogAsync<MergeContactsDialog>("Handle Duplicates — review merge",
                new DialogParameters
                {
                    [nameof(MergeContactsDialog.Preview)] = preview,
                    [nameof(MergeContactsDialog.ImportMode)] = true
                }, ct);
            var confirmed = await WaitForSyncDialogAsync(merge, ct);
            if (confirmed is { Canceled: false }) return (ContactImportDecision)confirmed.Data!;
            // Cancelling a pair returns to the account choices; cancelling that dialog stops sync.
        }
    }

    private static DialogOptions SyncDialogOptions => new()
        { FullWidth = true, MaxWidth = MaxWidth.Medium, BackdropClick = false };

    private void CancelSync()
    {
        syncCancellation?.Cancel();
        syncDialog?.Close();
    }

    public void Dispose()
    {
        disposed = true;
        CancelSync();
    }

    private sealed class SyncProgress(Action<int> report) : IProgress<int>
    {
        public void Report(int value) => report(value);
    }

    private async Task ImportFollowsAsync(Platform platform)
    {
        if (!CanStartSync) return;
        syncing = true;
        syncingX = platform == Platform.X;
        syncingMastodon = platform == Platform.Mastodon;
        syncCount = 0;
        message = null;
        using var cancellation = new CancellationTokenSource();
        syncCancellation = cancellation;
        var ct = cancellation.Token;
        var platforms = EnabledPlatforms.Platforms.ToArray();
        try
        {
            var prompt = await OpenSyncDialogAsync<HandleDuplicatesDialog>("Handle Duplicates", new DialogParameters(), ct);
            var answer = await WaitForSyncDialogAsync(prompt, ct);
            if (answer is null || answer.Canceled) return;
            ContactImportReviewer? reviewer = answer.Data is true ? ReviewImportAsync : null;
            var progress = new SyncProgress(n =>
            {
                syncCount = n;
                if (!disposed) _ = InvokeAsync(StateHasChanged);
            });
            var result = platform switch
            {
                Platform.X => await ContactSvc.SyncXFollowsAsync(progress, ct, platforms, reviewer),
                Platform.Mastodon => await ContactSvc.SyncMastodonFollowsAsync(progress, ct, platforms, reviewer),
                _ => await ContactSvc.SyncBlueskyFollowsAsync(blueskyHandle!, progress, ct, platforms, reviewer)
            };
            if (!disposed) Flash($"Synced {PlatformInfo.Label(platform)} follows: {result}");
        }
        catch (OperationCanceledException)
        {
            if (!disposed) Flash($"Sync cancelled after {syncCount} accounts processed. Completed imports remain saved; the account awaiting review was not saved. Retrying is safe.", true);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException
            or Microsoft.EntityFrameworkCore.DbUpdateException or Microsoft.Data.Sqlite.SqliteException)
        {
            if (!disposed) Flash($"Sync stopped after {syncCount} accounts processed. Completed imports remain saved; retrying is safe. {ex.Message}", true);
        }
        finally
        {
            syncCancellation = null;
            syncing = syncingX = syncingMastodon = false;
            if (!disposed) await LoadAsync();
        }
    }

    private void Flash(string text, bool isError = false)
    {
        message = text;
        messageIsError = isError;
    }

    private static Contact Clone(Contact c) => new()
    {
        Id = c.Id,
        Key = c.Key,
        DisplayName = c.DisplayName,
        AvatarUrl = c.AvatarUrl,
        Bio = c.Bio,
        BlueskyHandle = c.BlueskyHandle,
        BlueskyDid = c.BlueskyDid,
        MastodonAcct = c.MastodonAcct,
        MastodonUri = c.MastodonUri,
        MastodonProfileUrl = c.MastodonProfileUrl,
        XUsername = c.XUsername,
        XUserId = c.XUserId,
        XVerifiedByCopilotAtUtc = c.XVerifiedByCopilotAtUtc,
        LinkedInUrn = c.LinkedInUrn,
        LinkedInName = c.LinkedInName,
        LinkedInProfileUrl = c.LinkedInProfileUrl,
        LinkedInVerifiedByCopilotAtUtc = c.LinkedInVerifiedByCopilotAtUtc,
        Source = c.Source,
        CreatedAtUtc = c.CreatedAtUtc,
        LastUsedAtUtc = c.LastUsedAtUtc,
        UseCount = c.UseCount,
        DiscoveryRevision = c.DiscoveryRevision,
    };
