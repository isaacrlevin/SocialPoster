    private async Task HandleConflictsAsync()
    {
        if (busy || syncing || scanningConflicts || confirmingConflictScan || merging) return;
        confirmingConflictScan = true;
        try
        {
            if (await Dialogs.ShowMessageBoxAsync("Check contacts for conflicts",
                "This checks your contacts for possible duplicates and scores each pair from 1 to 99 by how likely they are the same person. With lots of contacts, it may take a moment. You will see progress while it runs. Nothing is merged automatically.",
                yesText: "Start scan", cancelText: "Cancel") != true) return;
            message = null;
            messageIsError = false;
            await ScanConflictsAsync();
            if (conflicts?.Count == 0 && !messageIsError) Flash("No suggested conflicts found.");
            else if (conflicts is { Count: > 0 })
            {
                confirmingConflictScan = false;
                await OpenConflictsAsync();
            }
        }
        catch (Exception ex) { Flash(ex.Message, true); }
        finally { confirmingConflictScan = false; }
    }

    private bool scanningConflicts;
    private bool confirmingConflictScan;
    private (long Completed, long Total)? conflictProgress;
    private double ConflictScanPercent => conflictProgress is { } scan
        ? scan.Total == 0 ? 100 : 100.0 * scan.Completed / scan.Total
        : 0;

    private async Task ScanConflictsAsync()
    {
        scanningConflicts = true;
        conflictProgress = null;
        StateHasChanged();
        var progress = new Progress<(long Completed, long Total)>(value =>
        {
            if (!scanningConflicts) return;
            conflictProgress = value;
            StateHasChanged();
        });
        try
        {
            conflicts = await ContactSvc.FindConflictsAsync(progress: progress);
            await PersistConflictsAsync();
        }
        finally
        {
            scanningConflicts = false;
            conflictProgress = null;
        }
    }

    private Task ReviewMergeAsync(ContactConflict conflict) => ReviewMergeAsync(conflict.Left.Id, conflict.Right.Id);

    private async Task ReviewMergeAsync(int leftId, int rightId)
    {
        if (busy || syncing || scanningConflicts || merging) return;
        merging = true;
        try
        {
            var preview = await ContactSvc.PreviewMergeAsync(leftId, rightId);
            var dialog = await Dialogs.ShowAsync<MergeContactsDialog>("Review contact merge",
                new DialogParameters { [nameof(MergeContactsDialog.Preview)] = preview },
                new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
            if (await dialog.Result is { Canceled: false })
            {
                editing = null;
                RemoveMergedSelections(leftId, rightId);
                Flash("Contacts merged. Old template keys remain valid as aliases.");
                await PersistConflictsAsync();
                await LoadAsync();
            }
        }
        catch (Exception ex) { Flash(ex.Message, true); }
        finally { merging = false; }
    }

    private void RemoveMergedSelections(int leftId, int rightId)
    {
        conflicts = conflicts?.Where(c => c.Left.Id != leftId && c.Right.Id != leftId &&
            c.Left.Id != rightId && c.Right.Id != rightId).ToList();
        mergeSelection.Clear();
    }

