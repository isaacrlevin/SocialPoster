    /// <summary>What to hand the Copilot agent when verifying a LinkedIn profile: the profile URL if known, else a company page built from the vanity name typed in the lookup box or a saved organization URN.</summary>
    private string? LinkedInVerifyIdentifier =>
        !string.IsNullOrWhiteSpace(editing?.LinkedInProfileUrl) ? editing.LinkedInProfileUrl
        : !string.IsNullOrWhiteSpace(companyVanity) ? $"https://www.linkedin.com/company/{companyVanity.Trim()}"
        : OrganizationUrlFromUrn(editing?.LinkedInUrn) is { } orgUrl ? orgUrl
        : null;

    /// <summary>LinkedIn accepts the numeric organization id in place of the vanity name, e.g. linkedin.com/company/1035.</summary>
    private static string? OrganizationUrlFromUrn(string? urn) =>
        urn is { Length: > 0 } u && u.StartsWith("urn:li:organization:", StringComparison.Ordinal)
            ? $"https://www.linkedin.com/company/{u["urn:li:organization:".Length..]}"
            : null;

