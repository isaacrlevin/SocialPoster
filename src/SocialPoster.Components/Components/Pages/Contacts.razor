    private async Task ImportAsync(IBrowserFile? file)
    {
        if (file is null || busy || syncing || scanningConflicts || merging) return;
        busy = importing = true;
        try
        {
            if (file.Size > MaxImportBytes)
            {
                Flash($"{file.Name} is larger than {MaxImportBytes / 1024 / 1024} MB, so it can't be a contacts export.", true);
                return;
            }
            string json;
            await using (var stream = file.OpenReadStream(MaxImportBytes))
            using (var reader = new StreamReader(stream))
                json = await reader.ReadToEndAsync();
            var result = await ContactSvc.ImportJsonAsync(json);
            editing = null;
            mergeSelection.Clear();
            Flash($"Imported {file.Name}: {result}", result.Skipped > 0 && result.Added + result.Updated == 0);
            await LoadAsync();
        }
        catch (Exception ex) { Flash($"Import failed: {ex.Message}", true); }
        finally { busy = importing = false; }
    }

