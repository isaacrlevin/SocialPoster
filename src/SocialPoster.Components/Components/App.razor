@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@Navigation.BaseUri" />
    @if (ResourcePreloaderType is not null) { <DynamicComponent Type="ResourcePreloaderType" /> }
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@Assets["_content/SocialPoster.Components/app.css"]" />
    <link rel="stylesheet" href="@Assets["_content/SocialPoster.Components/SocialPoster.Components.bundle.scp.css"]" />
    @if (ImportMapType is not null) { <DynamicComponent Type="ImportMapType" /> }
    <link rel="icon" type="image/svg+xml" href="_content/SocialPoster.Components/favicon.svg" />
    <link rel="icon" type="image/png" href="_content/SocialPoster.Components/favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes AppAssemblyName="@(AppAssembly.GetName().Name!)"
            AdditionalAssemblyNames="@AdditionalAssemblies?.Select(a => a.GetName().Name!).ToArray()"
            @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_content/SocialPoster.Components/js/composer.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // This document is only used by ASP.NET Core server hosts, but the library references the Components package
    // (not the server framework) so it also runs in MAUI. These server-only components are found at runtime.
    private static readonly Type? ResourcePreloaderType = Type.GetType(
        "Microsoft.AspNetCore.Components.ResourcePreloader, Microsoft.AspNetCore.Components.Endpoints");
    private static readonly Type? ImportMapType = Type.GetType(
        "Microsoft.AspNetCore.Components.ImportMap, Microsoft.AspNetCore.Components.Endpoints");

    /// <summary>Route assembly for the full-document sample shell.</summary>
    [Parameter] public Assembly AppAssembly { get; set; } = typeof(Routes).Assembly;

    /// <summary>Other route assemblies to include in the interactive router.</summary>
    [Parameter] public IEnumerable<Assembly>? AdditionalAssemblies { get; set; }
}
